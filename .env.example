ENVIRONMENT=development
COOKIE_SAMESITE=lax
# Set CSRF_SECRET_KEY to at least 32 random bytes in production.
# Optional Gmail SMTP for local development. Use a Google App Password, not
# your regular account password. Leave SMTP settings out to use the local outbox.
