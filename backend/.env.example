# Copy this file to backend/.env, then replace the placeholders.
# For Gmail, use a Google App Password (not your regular account password).
ENVIRONMENT=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_STARTTLS=true

# Private local PDF storage and Phase 4 MVP limits.
DOCUMENT_STORAGE_PATH=.local-storage
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_MAX_REQUEST_BYTES=27262976
DOCUMENT_STORAGE_QUOTA_BYTES=524288000
DOCUMENT_UPLOADS_PER_HOUR=10
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_EXTRACTED_TEXT_BYTES=10485760

# AI is disabled until a server-side key and reviewed pricing are configured.
AI_ENABLED=false
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_PROFILE_ID=openai-text-embedding-3-small-1536-v1
AI_EMBEDDING_DIMENSIONS=1536
AI_STRUCTURED_OUTPUT_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
AI_MAX_REQUEST_BYTES=8192
AI_QUERY_MAX_CHARS=2048
AI_CHUNK_TARGET_UTF8_BYTES=800
AI_CHUNK_MAX_UTF8_BYTES=1024
AI_CHUNK_OVERLAP_UTF8_BYTES=100
AI_EMBEDDING_BATCH_MAX_CHUNKS=16
AI_EMBEDDING_BATCH_MAX_UTF8_BYTES=16384
AI_RETRIEVAL_DEFAULT_TOP_K=5
AI_RETRIEVAL_MAX_TOP_K=8
AI_RETRIEVAL_MIN_SIMILARITY=0.2
AI_DAILY_INPUT_TOKEN_LIMIT=100000
AI_DAILY_COST_LIMIT_USD=0.50
# Required when enabling AI: AI_PRICING_VERSION and the model-specific
# *_USD_PER_MILLION rates. Populate them from the reviewed provider pricing.
